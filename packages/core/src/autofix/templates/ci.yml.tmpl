name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: <<GITHUB_WORKFLOW>>-<<GITHUB_REF>>
  cancel-in-progress: true

jobs:
  quality:
    name: Lint, typecheck, test, and production readiness
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install
        run: npm ci

      - name: Lint
        run: npm run lint --if-present

      - name: Typecheck
        run: npx tsc --noEmit --if-present

      - name: Test
        run: npm test --if-present

      - name: Build
        run: npm run build --if-present

      - name: Production readiness scan
        run: npx shipready scan . --threshold 50 --format markdown --output readiness.md

      - name: Upload readiness report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: production-readiness
          path: readiness.md

  # Optional: block merges on a readiness regression rather than an absolute
  # score, so an existing codebase can adopt ShipReady without going red.
