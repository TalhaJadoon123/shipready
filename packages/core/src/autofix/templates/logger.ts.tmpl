/**
 * Structured logger.
 *
 * pino is roughly five times faster than winston and logs JSON by default. The
 * important part is not the library: it is that you log an object, so every
 * field is queryable, and that redaction happens before serialisation, so a
 * secret cannot reach the log pipeline even by accident.
 *
 * String-interpolated logs cannot be queried. You cannot ask "show me every
 * request from this user that took over three seconds". With grep you can
 * only find a substring, and grep will not save you at 3am.
 */
import pino from 'pino';

const REDACT_PATHS = [
  'password',
  'token',
  'secret',
  'apiKey',
  'api_key',
  'authorization',
  'cookies',
  'req.headers.authorization',
  'req.headers.cookie',
  '*.password',
  '*.token',
];

export const logger = pino({
  level: process.env.LOG_LEVEL ?? 'info',
  redact: { paths: REDACT_PATHS, censor: '[REDACTED]' },
  base: { service: process.env.SERVICE_NAME ?? 'app' },
  timestamp: pino.stdTimeFunctions.isoTime,
});

