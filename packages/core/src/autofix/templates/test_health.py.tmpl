"""
Smoke test: the app starts and serves.

Not a substitute for real tests. It exists so that a build which cannot boot at
all cannot reach production, which is the most common failure in an app with no
test suite.
"""
from fastapi.testclient import TestClient

from main import app

client = TestClient(app)


def test_health_endpoint() -> None:
    response = client.get("/health")
    assert response.status_code == 200, f"health check failed: {response.text}"
    assert "status" in response.json()


def test_unknown_route_returns_404_not_500() -> None:
    # A 500 here usually means the exception handler is missing.
    response = client.get("/definitely-not-a-real-route")
    assert response.status_code == 404