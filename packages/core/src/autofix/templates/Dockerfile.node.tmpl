# syntax=docker/dockerfile:1
# Multi-stage build: compile deps in one stage, ship a slim runtime.

FROM node:22-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml* package-lock.json* ./
# --frozen-lockfile means "fail if the lockfile is stale", not "update it".
RUN (pnpm install --frozen-lockfile --prod=false || npm ci)

FROM node:22-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml* package-lock.json* ./
RUN (pnpm install --frozen-lockfile || npm ci)
COPY . .
RUN (pnpm build || npm run build)

FROM node:22-slim AS runner
ENV NODE_ENV=production
WORKDIR /app

# Never run as root: a container escape should not land on uid 0.
RUN groupadd --system nodejs && useradd --system --gid nodejs app

COPY --from=deps  /app/node_modules ./node_modules
COPY --from=builder /app/dist       ./dist
COPY --from=builder /app/public     ./public
COPY package.json ./

USER app
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0

# Only meaningful once /health exists. Uncomment after wiring the probe:
# HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
#   CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]