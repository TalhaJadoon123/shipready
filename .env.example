# ShipReady environment variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database (required for production dashboard with Postgres)
# =============================================================================
# Postgres connection string for the dashboard database.
# Used when SHIPREADY_DATABASE=postgres (production default).
# Example: postgres://user:pass@localhost:5432/shipready
DATABASE_URL=

# Alternative: use PGlite (embedded SQLite) for zero-config persistence
# SHIPREADY_DATABASE=pglite
# SHIPREADY_PGLITE_PATH=./.shipready/pglite

# Alternative: use file-backed in-memory store (development default)
# SHIPREADY_DATABASE=memory
# SHIPREADY_MEMORY_PATH=.shipready/dashboard.json

# =============================================================================
# AI Provider API Keys (required for compliance docs, agent observability)
# =============================================================================
# OpenAI API key for LLM calls (compliance generation, agent observation)
OPENAI_API_KEY=

# Anthropic API key (alternative provider)
ANTHROPIC_API_KEY=

# =============================================================================
# GitHub (required for GitHub Action, compliance scanning)
# =============================================================================
# GitHub token with repo scope for the GitHub Action
GITHUB_TOKEN=

# =============================================================================
# Docker Compose (for local production-like stack)
# =============================================================================
POSTGRES_USER=shipready
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shipready
REDIS_PASSWORD=changeme

# =============================================================================
# Optional: Telemetry / Observability
# =============================================================================
# Set to 1 to enable anonymous usage telemetry (helps improve the product)
SHIPREADY_TELEMETRY=0

# =============================================================================
# Optional: Dashboard Port
# =============================================================================
# SHIPREADY_PORT=3001